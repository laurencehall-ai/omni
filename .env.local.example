# Salesforce Connected App credentials
# Create a Connected App in Setup > App Manager with scopes: api, refresh_token, offline_access
# Set the callback URL to: http://localhost:3000/api/auth/callback
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
SF_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Session encryption secret — generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_32_byte_hex_secret

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
